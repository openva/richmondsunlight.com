{
    "config": {
        "vendor-dir": "htdocs/includes/vendor"
    },
    "require": {
        "php": "^8.0",
        "phpmailer/phpmailer": "^6.5",
        "ezyang/htmlpurifier": "^4.13",
        "doctrine/instantiator": "^2.0",
        "simplepie/simplepie": "^1.7",
        "aws/aws-sdk-php": "^3.186"
    },
    "autoload": {
        "classmap": [
            "htdocs/includes/vendor/"
        ],
        "files": ["htdocs/includes/functions.inc.php"]
    },
    "scripts": {
        "post-install-cmd": [
            "curl -fsSL https://raw.githubusercontent.com/manticoresoftware/manticoresearch/master/api/sphinxapi.php -o htdocs/includes/vendor/sphinxapi.php",
            "sed -i.bak \"s/0x120/0x11F/g\" htdocs/includes/vendor/sphinxapi.php && rm htdocs/includes/vendor/sphinxapi.php.bak"
        ],
        "post-update-cmd": [
            "@post-install-cmd"
        ]
    }
}
