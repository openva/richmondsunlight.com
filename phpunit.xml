<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="htdocs/includes/vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         defaultTestSuite="default">
    <testsuites>
        <testsuite name="default">
            <directory>deploy/tests/phpunit</directory>
        </testsuite>
        <testsuite name="local">
            <directory>tests/local</directory>
        </testsuite>
    </testsuites>
    <!-- The code that test coverage is reported for (see deploy/tests/run-all.sh) -->
    <source>
        <include>
            <directory suffix=".php">htdocs</directory>
        </include>
        <exclude>
            <directory>htdocs/includes/vendor</directory>
            <directory>htdocs/js</directory>
            <directory>htdocs/admin</directory>
        </exclude>
    </source>
</phpunit>
